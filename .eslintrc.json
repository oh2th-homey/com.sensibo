{
  "extends": "athom",
  "rules": {
    "camelcase": "off",
    "comma-dangle": "off",
    "prefer-destructuring": "off",
    "no-console": "off",
    "no-unused-vars": "off",
    "no-empty-function": "off",
    "padded-blocks": "off",
    "no-nested-ternary": "off"
  },
  "overrides": [
    {
      "files": [
        "test/**/*.js"
      ],
      "rules": {
        "node/no-unpublished-require": "off"
      }
    }
  ]
}
