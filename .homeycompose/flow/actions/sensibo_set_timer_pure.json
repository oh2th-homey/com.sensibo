{
  "id": "sensibo_set_timer_pure",
  "title": {
    "en": "Set timer",
    "nl": "Timer instellen"
  },
  "titleFormatted": {
    "en": "Set timer [[minutesFromNow]], [[on]], [[fanLevel]]",
    "nl": "Timer instellen [[minutesFromNow]], [[on]], [[fanLevel]]"
  },
  "hint": {
    "en": "Set minutes from now and select one or more parameters to be changed when the timer fires.",
    "nl": "Stel het aantal minuten in en selecteer een of meer parameters die worden gewijzigd wanneer de timer afgaat."
  },
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "driver_id=SensiboPure"
    },
    {
      "name": "minutesFromNow",
      "type": "number",
      "min": 1,
      "max": 1440,
      "step": 1,
      "placeholder": {
        "en": "Minutes from now",
        "nl": "Aantal minuten vanaf nu"
      }
    },
    {
      "name": "on",
      "title": {
        "en": "On / off",
        "nl": "Aan / uit"
      },
      "type": "dropdown",
      "values": [
        {
          "id": "nop",
          "label": {
            "en": "- Unchanged -",
            "nl": "- Ongewijzigd -"
          }
        },
        {
          "id": "off",
          "label": {
            "en": "Off",
            "nl": "Uit"
          }
        },
        {
          "id": "on",
          "label": {
            "en": "On",
            "nl": "Aan"
          }
        }
      ]
    },
    {
      "name": "fanLevel",
      "title": {
        "en": "Fan level",
        "nl": "Ventilatorsnelheid"
      },
      "type": "dropdown",
      "values": [
        {
          "id": "nop",
          "label": {
            "en": "- Unchanged -",
            "nl": "- Ongewijzigd -"
          }
        },
        {
          "id": "high",
          "label": {
            "en": "High",
            "nl": "Hoog"
          }
        },
        {
          "id": "low",
          "label": {
            "en": "Low",
            "nl": "Laag"
          }
        }
      ]
    }
  ]
}