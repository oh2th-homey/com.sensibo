{
  "id": "sensibo_set_timer",
  "title": {
    "en": "Set timer",
    "nl": "Timer instellen"
  },
  "titleFormatted": {
    "en": "Set timer [[minutesFromNow]], [[on]], [[mode]], [[fanLevel]], [[targetTemperature]]",
    "nl": "Timer instellen [[minutesFromNow]], [[on]], [[mode]], [[fanLevel]], [[targetTemperature]]"
  },
  "hint": {
    "en": "Set minutes from now and select one or more parameters to be changed when the timer fires.",
    "nl": "Stel het aantal minuten in en selecteer een of meer parameters die worden gewijzigd wanneer de timer afgaat."
  },
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "driver_id=Sensibo"
    },
    {
      "name": "minutesFromNow",
      "type": "number",
      "min": 1,
      "max": 1440,
      "step": 1,
      "placeholder": {
        "en": "Minutes from now",
        "nl": "Aantal minuten vanaf nu"
      }
    },
    {
      "name": "on",
      "title": {
        "en": "On / off",
        "nl": "Aan / uit"
      },
      "type": "dropdown",
      "values": [
        {
          "id": "nop",
          "label": {
            "en": "- Unchanged -",
            "nl": "- Ongewijzigd -"
          }
        },
        {
          "id": "off",
          "label": {
            "en": "Off",
            "nl": "Uit"
          }
        },
        {
          "id": "on",
          "label": {
            "en": "On",
            "nl": "Aan"
          }
        }
      ]
    },
    {
      "name": "mode",
      "title": {
        "en": "Mode",
        "nl": "Modus"
      },
      "type": "dropdown",
      "values": [
        {
          "id": "nop",
          "label": {
            "en": "- Unchanged -",
            "nl": "- Ongewijzigd -"
          }
        },
        {
          "id": "cool",
          "label": {
            "en": "Cool",
            "nl": "Koelen"
          }
        },
        {
          "id": "heat",
          "label": {
            "en": "Heat",
            "nl": "Verwarmen"
          }
        },
        {
          "id": "fan",
          "label": {
            "en": "Fan",
            "nl": "Ventileren"
          }
        },
        {
          "id": "auto",
          "label": {
            "en": "Auto"
          }
        },
        {
          "id": "dry",
          "label": {
            "en": "Dry",
            "nl": "Drogen"
          }
        }
      ]
    },
    {
      "name": "fanLevel",
      "title": {
        "en": "Fan level",
        "nl": "Ventilatorsnelheid"
      },
      "type": "dropdown",
      "values": [
        {
          "id": "nop",
          "label": {
            "en": "- Unchanged -",
            "nl": "- Ongewijzigd -"
          }
        },
        {
          "id": "auto",
          "label": {
            "en": "Auto"
          }
        },
        {
          "id": "high",
          "label": {
            "en": "High",
            "nl": "Hoog"
          }
        },
        {
          "id": "medium",
          "label": {
            "en": "Medium",
            "nl": "Middel"
          }
        },
        {
          "id": "low",
          "label": {
            "en": "Low",
            "nl": "Laag"
          }
        }
      ]
    },
    {
      "name": "targetTemperature",
      "type": "range",
      "min": 0,
      "max": 30,
      "step": 1,
      "label": "°C",
      "labelDecimals": 0,
      "title": {
        "en": "Target temperature",
        "nl": "Doeltemperatuur"
      }
    }
  ]
}